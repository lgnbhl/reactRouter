Package: reactRouter
Type: Package
Title: 'React Router' for 'shiny' Apps and 'Quarto'
Version: 0.2.1
Authors@R: c(
    person(given = "Felix", family = "Luginbuhl", role = c("aut", "cre", "cph"), email = "felix.luginbuhl@protonmail.ch", comment = c(ORCID = "0009-0008-6625-2899")),
